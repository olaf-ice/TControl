# ==============================================================================
# TControl AI Computer Vision & Stop-Line Enforcement Worker - Dockerfile
# ==============================================================================
FROM python:3.11-slim

WORKDIR /app

# Install minimal system libraries for OpenCV headless and networking
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libglib2.0-0 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast, reliable Python package resolution
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Copy package configuration
COPY ai-service/requirements.txt ./
RUN uv pip install --system --no-cache -r requirements.txt

# Copy AI service source code
COPY ai-service/ ./

# Expose FastAPI service port
EXPOSE 8000

ENV PYTHONUNBUFFERED=1
ENV NODE_BACKEND_URL=http://web:3000

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

# Start FastAPI application
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
