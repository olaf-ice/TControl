# ==============================================================================
# TControl Web Dashboard & Enforcement Portal - Dockerfile
# ==============================================================================
FROM node:20-alpine

WORKDIR /app

# Set environment
ENV NODE_ENV=production
ENV PORT=3000

# Copy package manifests and application code
COPY package.json ./
RUN npm install --omit=dev || true

COPY data/ ./data/
COPY public/ ./public/
COPY server.js ./
COPY README.md ./

# Expose web dashboard port
EXPOSE 3000

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:3000/api/stats || exit 1

# Start server
CMD ["node", "server.js"]
